{
  "expo": {
    "name": "COCO Eventos Gratis",
    "slug": "coco-eventos-gratis",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cocoeventosgratis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDFBF9",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mel000n.cocoeventosgratis"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDFBF9",
          "image": "./assets/images/splash.png",
          "imageWidth": 250
        }
      ],
      "expo-sqlite",
      "expo-font",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90593786-2465-4e9d-a6ad-e2d3018c15c9"
      }
    }
  }
}
